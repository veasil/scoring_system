[Unit]
Description=WQT Admin Panel (Production)
After=network.target

[Service]
User=root
WorkingDirectory=/home/admin/app/scoring_system/admin-panel
ExecStart=/home/admin/app/scoring_system/venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0
Restart=always
Environment=PORT=8501

[Install]
WantedBy=multi-user.target
