# 端口
PORT=80

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# SQLite 数据库文件路径
DB_PATH=./data/app.sqlite

# （可选）LLM：把你的 Key 放这里，前端不会暴露
DEEPSEEK_API_KEY=sk-593ecbac27ad4599b139e91b64fa7afa
DEEPSEEK_MODEL=deepseek-reasoner

# （可选）微信登录（不同场景对应不同 AppID/Secret）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=
